{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Optional Worldbook Video relations 1.0",
  "description": "Storage schema 4; additive to worldbook.media image-only contract. Runtime additionally validates CAS, unique video IDs, contiguous order, trusted user/target authorization, command TTL/payload replay and coordinator ownership. No paths or media bytes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "readRequest",
    "read",
    "add",
    "remove",
    "replace",
    "reorder",
    "result",
    "operationRequest",
    "operationFound",
    "operationMissing"
  ],
  "properties": {
    "readRequest": {
      "$ref": "#/$defs/readRequest"
    },
    "read": {
      "$ref": "#/$defs/read"
    },
    "result": {
      "$ref": "#/$defs/result"
    },
    "operationRequest": {
      "$ref": "#/$defs/operationRequest"
    },
    "operationFound": {
      "$ref": "#/$defs/operation"
    },
    "operationMissing": {
      "$ref": "#/$defs/operation"
    },
    "add": {
      "$ref": "#/$defs/command"
    },
    "remove": {
      "$ref": "#/$defs/command"
    },
    "replace": {
      "$ref": "#/$defs/command"
    },
    "reorder": {
      "$ref": "#/$defs/command"
    }
  },
  "$defs": {
    "materialId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]{0,95}$"
    },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "commandId": {
      "type": "string",
      "pattern": "^[0-9]{13}-[a-f0-9-]{36}$"
    },
    "mediaRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "assetId"
      ],
      "properties": {
        "provider": {
          "const": "server"
        },
        "assetId": {
          "$ref": "#/$defs/uuid"
        }
      }
    },
    "attachment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "position",
        "mediaRef"
      ],
      "properties": {
        "kind": {
          "const": "video"
        },
        "position": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "mediaRef": {
          "$ref": "#/$defs/mediaRef"
        }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "attachments"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/materialId"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740990
        },
        "attachments": {
          "type": "array",
          "minItems": 0,
          "maxItems": 6,
          "items": {
            "$ref": "#/$defs/attachment"
          }
        }
      }
    },
    "readRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "materialIds"
      ],
      "properties": {
        "materialIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/materialId"
          },
          "uniqueItems": true
        }
      }
    },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/group"
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "video",
        "replayed"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/materialId"
        },
        "video": {
          "$ref": "#/$defs/group"
        },
        "replayed": {
          "type": "boolean"
        }
      }
    },
    "command": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commandId",
            "action",
            "data"
          ],
          "properties": {
            "commandId": {
              "$ref": "#/$defs/commandId"
            },
            "action": {
              "const": "video-add"
            },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "revision",
                "items"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/materialId"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740990
                },
                "items": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 6,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind",
                      "mediaRef"
                    ],
                    "properties": {
                      "kind": {
                        "const": "video"
                      },
                      "mediaRef": {
                        "$ref": "#/$defs/mediaRef"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commandId",
            "action",
            "data"
          ],
          "properties": {
            "commandId": {
              "$ref": "#/$defs/commandId"
            },
            "action": {
              "const": "video-remove"
            },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "revision",
                "assetId"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/materialId"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740990
                },
                "assetId": {
                  "$ref": "#/$defs/uuid"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commandId",
            "action",
            "data"
          ],
          "properties": {
            "commandId": {
              "$ref": "#/$defs/commandId"
            },
            "action": {
              "const": "video-replace"
            },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "revision",
                "assetId",
                "mediaRef"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/materialId"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740990
                },
                "assetId": {
                  "$ref": "#/$defs/uuid"
                },
                "mediaRef": {
                  "$ref": "#/$defs/mediaRef"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "commandId",
            "action",
            "data"
          ],
          "properties": {
            "commandId": {
              "$ref": "#/$defs/commandId"
            },
            "action": {
              "const": "video-reorder"
            },
            "data": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "revision",
                "assetIds"
              ],
              "properties": {
                "id": {
                  "$ref": "#/$defs/materialId"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740990
                },
                "assetIds": {
                  "type": "array",
                  "minItems": 0,
                  "maxItems": 6,
                  "items": {
                    "$ref": "#/$defs/uuid"
                  },
                  "uniqueItems": true
                }
              }
            }
          }
        }
      ]
    },
    "operationRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandId"
      ],
      "properties": {
        "commandId": {
          "$ref": "#/$defs/commandId"
        }
      }
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "found"
          ],
          "properties": {
            "found": {
              "const": false
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "found",
            "result"
          ],
          "properties": {
            "found": {
              "const": true
            },
            "result": {
              "$ref": "#/$defs/result"
            }
          }
        }
      ]
    }
  }
}
