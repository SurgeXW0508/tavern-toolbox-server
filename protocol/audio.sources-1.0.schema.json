{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tavern Toolbox Stable Audio Sources 1.0",
  "description": "Per ST user stable Source identity, independent Audio Assets. Protected controls; ST session native Remote/Local stream. Stage 1 fields stay compatible, revision guards Source binding mutations. Source paths contain no original URL.",
  "$defs": {
    "sourceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{32}$"
    },
    "createRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048,
          "pattern": "^https?://"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "backend",
        "hostname",
        "localAssetId",
        "createdAt",
        "updatedAt",
        "playbackPath"
      ],
      "properties": {
        "sourceId": {
          "$ref": "#/$defs/sourceId"
        },
        "backend": {
          "enum": [
            "remote",
            "local"
          ]
        },
        "hostname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253
        },
        "localAssetId": {
          "anyOf": [
            {
              "$ref": "#/$defs/sourceId"
            },
            {
              "type": "null"
            }
          ]
        },
        "createdAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "playbackPath": {
          "type": "string",
          "pattern": "^/api/plugins/tavern-toolbox-server/v1/audio/sources/[A-Za-z0-9_-]{32}/stream$"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "asset": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "audio.assets-1.0.schema.json#/$defs/asset"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "assetId",
                "health",
                "code"
              ],
              "properties": {
                "assetId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{32}$"
                },
                "health": {
                  "const": "unavailable"
                },
                "code": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
                }
              }
            }
          ]
        }
      }
    },
    "createResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "reused"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "reused": {
          "type": "boolean"
        }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "nextCursor"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "nextCursor": {
          "anyOf": [
            {
              "$ref": "#/$defs/sourceId"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "deleteRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "deleteResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "removed"
      ],
      "properties": {
        "removed": {
          "const": true
        }
      }
    },
    "revisionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "backendRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "backend"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "backend": {
          "enum": [
            "remote",
            "local"
          ]
        }
      }
    },
    "lookupResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source"
      ],
      "properties": {
        "source": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/source"
            }
          ]
        }
      }
    },
    "job": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jobId",
        "sourceId",
        "state",
        "receivedBytes",
        "totalBytes",
        "code",
        "details"
      ],
      "properties": {
        "jobId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{32}$"
        },
        "sourceId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{32}$"
        },
        "state": {
          "enum": [
            "pending",
            "downloading",
            "committing",
            "completed",
            "failed",
            "cancelled"
          ]
        },
        "receivedBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1073741824
        },
        "totalBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 1073741824
        },
        "code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hostname": {
              "type": "string",
              "pattern": "^[a-z0-9.-]{1,253}$"
            }
          }
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    }
  }
}
